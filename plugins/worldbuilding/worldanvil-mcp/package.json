{
  "name": "worldanvil-mcp",
  "version": "1.12.0-fork.1",
  "description": "World Anvil MCP server (independent fork): requires your own World Anvil application key and user token, talks only to World Anvil directly.",
  "main": "index.js",
  "bin": {
    "worldanvil-mcp": "index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.js"
  },
  "keywords": [
    "mcp",
    "worldanvil",
    "worldbuilding",
    "claude",
    "cursor",
    "ai",
    "rpg",
    "ttrpg",
    "writing"
  ],
  "author": "Leighton Carden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carnivalius/worldanvil-mcp.git",
    "directory": "plugins/worldbuilding/worldanvil-mcp"
  },
  "homepage": "https://github.com/Carnivalius/worldanvil-mcp#readme",
  "bugs": {
    "url": "https://github.com/Carnivalius/worldanvil-mcp/issues"
  },
  "files": [
    "index.js",
    "src/",
    "CLAUDE.md",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "vitest": "^4.0.16"
  },
  "private": true,
  "contributors": [
    "Carnivalius (fork maintainer)"
  ]
}
